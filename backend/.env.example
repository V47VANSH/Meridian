# Copy to .env for local overrides. Every value below has a working default, so
# nothing here is required to run the API in development — the defaults give you
# SQLite, a dev JWT secret, and the deterministic fallbacks for the ML service
# and the AI assistant.
#
# Nothing in this file is a real secret. Production values are supplied as
# environment variables by the host and are never committed.

# --- Database ---------------------------------------------------------------
# SQLite by default so the project clones and runs with no database server.
# Point at Postgres for a real deployment, e.g.
#   postgresql+psycopg://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./acms.db
# Who owns the schema. Defaults to true for SQLite (build it from the models)
# and false otherwise (Alembic migrations own it). Letting create_all run
# against a migrated database creates tables Alembic never stamped, and the
# next `alembic upgrade` then fails on tables that already exist.
AUTO_CREATE_TABLES=

# --- Auth -------------------------------------------------------------------
# MUST be replaced in any deployment. Tokens signed with the default are
# forgeable by anyone who has read the repository.
JWT_SECRET=dev-only-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# PBKDF2 iterations. The test suite lowers this so a run that hashes hundreds of
# passwords stays fast; leave it high everywhere else.
PASSWORD_HASH_ROUNDS=260000

# --- Redis (optional) -------------------------------------------------------
# Backs the booking slot lock and the rate limiter. Unset, both fall back to
# in-process equivalents — correct for one instance, insufficient for several,
# because a per-process counter lets a caller multiply their rate-limit
# allowance by the number of workers.
REDIS_URL=
REDIS_TIMEOUT_SECONDS=2.0
SLOT_LOCK_TTL_MS=5000
SLOT_LOCK_WAIT_MS=3000

# --- Rate limiting ----------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_DEFAULT=240
# Tighter where abuse lands: /auth/* is credential stuffing, /sos fans out to
# every guard over push and SMS.
RATE_LIMIT_AUTH=20
RATE_LIMIT_SOS=10
# Only enable behind a proxy that overwrites X-Forwarded-For (Render, Vercel).
# A client can set that header themselves, so trusting it anywhere else lets
# anyone reset their own rate-limit counter at will.
TRUST_PROXY_HEADERS=false

# --- ML service -------------------------------------------------------------
# Leave empty and complaint classification falls back to the keyword classifier
# and flags every complaint for manual triage. Set it to run the trained models:
#   ML_SERVICE_URL=http://localhost:8100
ML_SERVICE_URL=
# Must match ML_SHARED_SECRET on the ML service. When both are empty the ML
# service accepts unauthenticated calls, which is fine locally.
ML_SHARED_SECRET=
ML_TIMEOUT_SECONDS=2.0
# Predictions below this confidence are discarded in favour of the keyword
# fallback, and the complaint is flagged for a human to confirm.
ML_CONFIDENCE_THRESHOLD=0.55
# Payment risk at or above this triggers the early reminder.
PAYMENT_RISK_REMINDER_THRESHOLD=0.5

# --- Payments ---------------------------------------------------------------
# Razorpay test-mode credentials. With the placeholder key the API still records
# a payment order, but checkout cannot complete — an official records the
# payment against the invoice instead.
RAZORPAY_KEY_ID=rzp_test_dummy
RAZORPAY_KEY_SECRET=dummy_secret
RAZORPAY_WEBHOOK_SECRET=dummy_webhook_secret

# --- AI assistant -----------------------------------------------------------
# Unset, the assistant uses rule-based intent matching. Either way it classifies
# the request and routes the user to the screen that handles it.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Misc -------------------------------------------------------------------
# Comma-separated. The Vite dev server proxies /api, so CORS is not exercised
# in local development.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Creates the demo society and its accounts on first start. Set false in CI and
# anywhere the database is already populated.
SEED_ON_STARTUP=true
