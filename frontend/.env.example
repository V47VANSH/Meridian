# Copy to .env.local for local overrides. Both values have working defaults,
# so nothing here is required to run the app in development.

# Where the API lives, as seen by the browser. The default is a relative path,
# which the Vite dev proxy forwards to the backend. Set an absolute URL only
# when the API is deployed on a different origin to the frontend.
VITE_API_BASE_URL=/api

# Where the Vite dev server forwards /api. Change this if the backend is not on
# the default uvicorn port.
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
